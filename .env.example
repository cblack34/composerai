# Copy to .env and fill in. .env is gitignored. .env.example is the tracked sample.

# Live lead runs. Offline tests do not read this.
XAI_API_KEY=

# Pydantic AI model string for the lead.
COMPOSERAI_MODEL=xai:grok-4.7

# Mount that holds project folders. Compose uses /projects inside the container.
# On the host this is the repo's projects/ directory.
COMPOSERAI_PROJECT_ROOT=./projects

# Default project folder inside that mount.
# Files live at <root>/<project>/<section>/<file>.<ext>, never as direct children of the mount.
COMPOSERAI_PROJECT_NAME=demo
